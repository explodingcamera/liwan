---
import {
	CodeIcon,
	DatabaseIcon,
	KeyRoundIcon,
	ShieldCheckIcon,
	TablePropertiesIcon,
	UserIcon,
	UsersIcon,
} from "lucide-react";

import Layout from "./layout.astro";

type Props = {
	title: string;
};

const path = Astro.url.pathname;
const { title } = Astro.props;
---

<Layout {title}>
  <div class="settings">
    <aside class="mobile">
      <select
        name="select"
        aria-label="Select a page"
        id="select-settings-page"
      >
        <optgroup label="General">
          <option
            selected={path.startsWith("/settings/me") ? true : undefined}
            value="/settings/me">My Account</option
          >
          <option
            selected={path.startsWith("/settings/projects") ? true : undefined}
            value="/settings/projects">Projects</option
          >
          <option
            selected={path.startsWith("/settings/entities") ? true : undefined}
            value="/settings/entities">Entities</option
          >
        </optgroup>
        <optgroup label="Admin" data-admin-nav>
          <option
            selected={path.startsWith("/settings/collection")
              ? true
              : undefined}
            value="/settings/collection">Collection</option
          >
          <option
            selected={path.startsWith("/settings/users") ? true : undefined}
            value="/settings/users">Users</option
          >
          <option
            selected={path.startsWith("/settings/authentication") ? true : undefined}
            value="/settings/authentication">Authentication</option
          >
          <option
            selected={path.startsWith("/settings/api-keys") ? true : undefined}
            value="/settings/api-keys">API Keys</option
          >
        </optgroup>
      </select>
    </aside>
    <aside class="desktop">
      <h3>General</h3>
      <ul class="sidebar">
        <li>
          <a
            data-active={path.startsWith("/settings/me") ? "true" : "false"}
            aria-current={path.startsWith("/settings/me") ? "page" : undefined}
            href="/settings/me"
          >
            <UserIcon size="20" />
            My Account</a
          >
        </li>

        <li>
          <a
            data-active={path.startsWith("/settings/projects")
              ? "true"
              : "false"}
            aria-current={path.startsWith("/settings/projects")
              ? "page"
              : undefined}
            href="/settings/projects"
          >
            <TablePropertiesIcon size="20" />
            Projects</a
          >
        </li>
        <li>
          <a
            data-active={path.startsWith("/settings/entities")
              ? "true"
              : "false"}
            aria-current={path.startsWith("/settings/entities")
              ? "page"
              : undefined}
            href="/settings/entities"
          >
            <CodeIcon size="20" />
            Entities</a
          >
        </li>
      </ul>
      <h3 data-admin-nav>Admin</h3>
      <ul class="sidebar" data-admin-nav>
        <li>
          <a
            data-active={path.startsWith("/settings/collection")
              ? "true"
              : "false"}
            aria-current={path.startsWith("/settings/collection")
              ? "page"
              : undefined}
            href="/settings/collection"
          >
            <DatabaseIcon size="20" />
            Collection</a
          >
        </li>
        <li>
          <a
            data-active={path.startsWith("/settings/users") ? "true" : "false"}
            aria-current={path.startsWith("/settings/users")
              ? "page"
              : undefined}
            href="/settings/users"
          >
            <UsersIcon size="20" />
            Users</a
          >
        </li>
        <li>
          <a
            data-active={path.startsWith("/settings/authentication")
              ? "true"
              : "false"}
            aria-current={path.startsWith("/settings/authentication")
              ? "page"
              : undefined}
            href="/settings/authentication"
          >
            <ShieldCheckIcon size="20" />
            Authentication</a
          >
        </li>
        <li>
          <a
            data-active={path.startsWith("/settings/api-keys") ? "true" : "false"}
            aria-current={path.startsWith("/settings/api-keys") ? "page" : undefined}
            href="/settings/api-keys"
          >
            <KeyRoundIcon size="20" />
            API Keys</a
          >
        </li>
      </ul>
    </aside>
    <article class="content">
      <slot />
    </article>
  </div>
</Layout>

<script>
  import { navigate } from "astro:transitions/client";

  const adminPaths = ["/settings/collection", "/settings/users", "/settings/authentication", "/settings/api-keys"];

  function handleSelectChange(event: Event) {
    navigate((event.currentTarget as HTMLSelectElement).value);
  }

  document.addEventListener("astro:page-load", async () => {
    const settings = document.querySelector<HTMLElement>(".settings");
    if (!settings) return;
    document.getElementById("select-settings-page")?.addEventListener("change", handleSelectChange);

    try {
      const response = await fetch("/api/dashboard/auth/me");
      if (response.status === 401) {
        const returnTo = `${window.location.pathname}${window.location.search}${window.location.hash}`;
        window.location.replace(`/login?${new URLSearchParams({ returnTo })}`);
        return;
      }
      if (!response.ok) throw new Error("Failed to load account");

      const { role } = await response.json();
      if (role !== "admin") {
        if (adminPaths.some((path) => window.location.pathname === path || window.location.pathname.startsWith(`${path}/`))) {
          window.location.replace("/settings/me");
          return;
        }
        settings.querySelector("optgroup[data-admin-nav]")?.remove();
      }
      settings.dataset.role = role;
    } catch {
      settings.querySelector<HTMLElement>(".content")!.textContent = "Failed to load account. Refresh to try again.";
      settings.dataset.role = "user";
    }
  });
</script>

<style>
  .settings:not([data-role]) {
    visibility: hidden;
  }

  .settings:not([data-role="admin"]) [data-admin-nav] {
    display: none;
  }

  .settings :global(nav) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
    min-height: 2.15rem;
  }

  .settings :global(nav.list-header) {
    min-height: 2.15rem;
  }

  .settings :global(nav.list-header button),
  .settings :global(nav > button[type="submit"]) {
    translate: 7px -2px;
  }

  .settings :global(h1) {
    font-size: 1.5rem;
    margin: 0;
  }

  .settings :global(.description) {
    max-width: 46rem;
    margin-bottom: 1rem;
    color: var(--text-muted);
  }

  .settings {
    display: flex;
    height: 100%;
    margin-top: 1rem;
  }

  .settings :global(.content),
  .content {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 0.8rem 1rem;
    border-radius: var(--radius);
    background: var(--surface);
  }

  aside {
    display: flex;
    flex-direction: column;
    width: 11rem;
    gap: 0.4rem;
    margin-right: 1.5rem;

    h3 {
      margin: 0;
      margin-left: 0.3rem;
      margin-top: 0.2rem;
      font-size: 1rem;
    }
  }

  .sidebar {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-bottom: 1rem;

    li {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    a {
      line-height: 1.25;
      font-size: 0.9rem;
      text-decoration: none;
      transition: all 0.2s;
      border-radius: var(--radius);
      padding: 0.3rem 0.4rem;
      width: 100%;
      display: flex;
      align-items: center;
      gap: 0.4rem;
      color: var(--accent);

      svg {
        width: 1.125rem;
        height: 1.125rem;
        flex: none;
      }
    }

    a[data-active="true"] {
      color: var(--text-strong);
      background: var(--surface);
    }

    a:hover {
      color: var(--text-strong);
      background: var(--surface);
    }
  }

  main {
    padding: 20px;
  }

  .mobile {
    display: none;
    width: 100%;
    margin-bottom: 1rem;
  }
  @media (max-width: 768px) {
    .mobile {
      display: block;
    }
    .desktop {
      display: none;
    }
    .settings {
      flex-direction: column;
    }
    .content { padding: 0.8rem; }
  }
</style>

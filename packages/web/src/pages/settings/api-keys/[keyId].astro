---
import type { GetStaticPaths } from "astro";

import { ApiKeySettingsPage } from "@/components/settings/api-keys";
import Settings from "@/layouts/settings.astro";

export const getStaticPaths = (() => {
	return [{ params: { keyId: "key" } }];
}) satisfies GetStaticPaths;

const { keyId } = Astro.params;
---

<Settings title="API Key Settings">
  <ApiKeySettingsPage keyId={keyId ?? ""} client:load />
</Settings>

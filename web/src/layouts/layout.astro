---
import { FontSizeSwitcher } from "@/components/ui/font-size-switcher";
import { LoginButton } from "@/components/ui/user-info";
import Base from "./base.astro";

type Props = {
	title: string;
};

const { title } = Astro.props;
---

<Base {title}>
  <header class="container-fluid">
    <nav>
      <ul>
        <li>
          <a href="/" class="contrast logo">
            <img src="/favicon.svg" alt="liwan logo" width="22" height="22" />
            <strong>liwan</strong>
          </a>
        </li>
      </ul>
      <ul class="navRight">
        <li><FontSizeSwitcher client:only="react" /></li>
        <li class="login"><LoginButton client:only="react" /></li>
      </ul>
    </nav>
  </header>
  <main class="container-fluid">
    <slot />
  </main>
</Base>

<style>
  main {
    flex: 1;
    padding-top: 0.25rem;
    padding-bottom: 1.5rem;
  }

  .login {
    position: relative;
  }

  nav {
    min-height: 2.25rem;
    height: auto;
  }

  nav ul {
    align-items: center;
    gap: 0.35rem;
  }

  nav li {
    padding: 0.15rem 0.25rem;
    display: inline-flex;
    align-items: center;
  }

  .navRight {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.95rem;
  }

  main,
  header {
    max-width: min(72rem, 1200px);
    padding-left: 1rem;
    padding-right: 1rem;
  }

  header {
    padding-top: 0.35rem;
    padding-bottom: 0;
  }
</style>
